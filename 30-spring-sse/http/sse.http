# Сквозная проверка двух экземпляров, поднятых через docker compose.
# Запускать целиком сверху вниз в окружении "docker": запросы передают друг
# другу значения метрик через client.global.
# Уведомления отправляются по gRPC через второй экземпляр, а приём проверяется
# по ответу PUBLISH и метрикам первого: так видно, что событие прошло через Redis.

### Первый экземпляр жив
GET {{one}}/actuator/health

> {%
    client.test("Первый экземпляр отвечает UP", () => {
        client.assert(response.status === 200, `Здоровье ответило ${response.status}`);
        client.assert(response.body.status === "UP", `Статус ${response.body.status}`);
    });
%}

### Второй экземпляр жив
GET {{two}}/actuator/health

> {%
    client.test("Второй экземпляр отвечает UP", () => {
        client.assert(response.status === 200, `Здоровье ответило ${response.status}`);
        client.assert(response.body.status === "UP", `Статус ${response.body.status}`);
    });
%}

### Сколько уведомлений первый экземпляр получил из Redis до отправки
GET {{one}}/actuator/prometheus

> {%
    const received = response.body.match(/^redis_sse_receive_total\{[^}]*} (\S+)$/m);
    client.test("Метрика полученных уведомлений есть", () => {
        client.assert(received !== null, "Нет метрики redis_sse_receive_total");
    });
    client.global.set("receivedBefore", received[1]);
%}

### Сколько уведомлений второй экземпляр отправил до отправки
GET {{two}}/actuator/prometheus

> {%
    const published = response.body.match(/^redis_sse_publish_total\{[^}]*} (\S+)$/m);
    client.test("Метрика отправленных уведомлений есть", () => {
        client.assert(published !== null, "Нет метрики redis_sse_publish_total");
    });
    client.global.set("publishedBefore", published[1]);
%}

### Уведомление пользователю без открытого потока через второй экземпляр
# Канал пользователя никто не слушает: PUBLISH отвечает нулём получателей,
# а нулевое поле proto3 в JSON-ответе опускается.
GRPC {{grpcTwo}}/ru.sprbut.m30.Notifier/SendToUser

{
  "userId": {{$random.integer(1, 1000000)}},
  "text": "Привет, {{$random.alphanumeric(8)}}"
}

> {%
    client.test("Уведомление пользователю без потока не получил ни один экземпляр", () => {
        const receivers = Number(response.body.receivers || 0);
        client.assert(receivers === 0, `Получателей ${receivers}`);
    });
%}

### Уведомление всем через второй экземпляр
GRPC {{grpcTwo}}/ru.sprbut.m30.Notifier/Broadcast

{
  "event": "news",
  "text": "Всем, {{$random.alphanumeric(8)}}"
}

> {%
    client.test("Общее уведомление получили оба экземпляра", () => {
        const receivers = Number(response.body.receivers || 0);
        client.assert(receivers === 2, `Получателей ${receivers}`);
    });
%}

### Второй экземпляр отправил оба уведомления в Redis
GET {{two}}/actuator/prometheus

> {%
    const published = response.body.match(/^redis_sse_publish_total\{[^}]*} (\S+)$/m);
    client.test("Отправлено ровно два уведомления", () => {
        const delta = Number(published[1]) - Number(client.global.get("publishedBefore"));
        client.assert(delta === 2, `Отправлено ${delta}`);
    });
%}

### Первый экземпляр получил из Redis только общее уведомление
# На личный канал пользователя без потока экземпляр не подписан.
GET {{one}}/actuator/prometheus

> {%
    const received = response.body.match(/^redis_sse_receive_total\{[^}]*} (\S+)$/m);
    client.test("Получено ровно одно уведомление", () => {
        const delta = Number(received[1]) - Number(client.global.get("receivedBefore"));
        client.assert(delta === 1, `Получено ${delta}`);
    });
%}

### Поток пользователя открывается и пингует
# Пинг в docker compose приходит раз в 2 секунды; поток закрывается после первого.
# @timeout 10
GET {{one}}/sse/stream/{{$random.integer(1, 1000000)}}
Accept: text/event-stream

> {%
    client.test("Поток отдаётся как text/event-stream", () => {
        client.assert(response.status === 200, `Поток ответил ${response.status}`);
        client.assert(
            response.contentType.mimeType === "text/event-stream",
            `Тип ${response.contentType.mimeType}`
        );
    });
    client.global.set("streamLine", "");
    response.body.onEachLine((line, unsubscribe) => {
        client.global.set("streamLine", line);
        unsubscribe();
    });
%}

### Первая строка потока — пинг
# Проверки внутри onEachLine клиент не показывает, поэтому строка потока
# проверяется здесь, в обработчике следующего запроса.
GET {{one}}/actuator/health

> {%
    client.test("Поток начался с пинга", () => {
        const line = client.global.get("streamLine");
        client.assert(line.includes("ping"), `Первая строка потока: [${line}]`);
    });
%}
