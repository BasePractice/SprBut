### Список профилей видит администратор
GET {{gateway}}/profiles
Authorization: Bearer {{adminToken}}

> {%
    client.test("Администратор видит нового пользователя в списке", () => {
        client.assert(response.status === 200, `Список ответил ${response.status}`);
        const ids = response.body.map(profile => profile.id);
        client.assert(ids.includes(client.global.get("userId")), "Нового пользователя нет в списке");
    });
%}

