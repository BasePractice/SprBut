### Пользователь видит свою сессию
GET {{gateway}}/auth/users/{{userId}}/sessions
Authorization: Bearer {{userToken}}

> {%
    client.test("Одна активная сессия без токенов", () => {
        client.assert(response.status === 200, `Сессии ответили ${response.status}`);
        client.assert(response.body.length === 1, `Сессий ${response.body.length}`);
        client.assert(!("refresh_token" in response.body[0]), "В списке сессий есть токен");
    });
%}

### Обмен refresh-токена на новую пару
POST {{gateway}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{userRefresh}}"
}

> {%
    const previous = client.global.get("userRefresh");
    client.test("Обмен выдал новую пару", () => {
        client.assert(response.status === 200, `Обмен ответил ${response.status}`);
        client.assert(response.body.refresh_token !== previous, "Refresh не сменился");
    });
    client.global.set("oldRefresh", previous);
    client.global.set("userRefresh", response.body.refresh_token);
    client.global.set("userToken", response.body.access_token);
%}

### Повторный обмен старого refresh-токена
POST {{gateway}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{oldRefresh}}"
}

> {%
    client.test("Старый refresh даёт 401", () => {
        client.assert(response.status === 401, `Ожидался 401, пришёл ${response.status}`);
    });
%}

### После повтора старого refresh вся сессия закрыта
POST {{gateway}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{userRefresh}}"
}

> {%
    client.test("Новый refresh той же сессии тоже даёт 401", () => {
        client.assert(response.status === 401, `Ожидался 401, пришёл ${response.status}`);
    });
%}

### Access-токен закрытой сессии отвергается gateway
< {%
    const start = Date.now();
    while (Date.now() - start < 11000) {
        // Ждём, пока у gateway истечёт кэш ответа «сессия активна».
    }
%}
GET {{gateway}}/me
Authorization: Bearer {{userToken}}

> {%
    client.test("Отозванный access-токен даёт 401", () => {
        client.assert(response.status === 401, `Ожидался 401, пришёл ${response.status}`);
    });
%}

