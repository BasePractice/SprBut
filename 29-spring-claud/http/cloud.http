# Сквозная проверка проекта, поднятого через docker compose. Все запросы идут
# через gateway, кроме первого — к реестру Eureka.
# Запускать целиком сверху вниз в окружении "docker": запросы передают друг другу
# токены и идентификаторы через client.global. Каждый прогон регистрирует нового
# пользователя со случайным логином и в конце удаляет его.
# Gateway помнит ответ «сессия активна» 10 секунд, поэтому перед проверкой отзыва
# access-токена сценарий ждёт 11 секунд.

### Все сервисы зарегистрированы в Eureka
GET {{discovery}}/eureka/apps
Accept: application/json

> {%
    client.test("Реестр отвечает", () => {
        client.assert(response.status === 200, `Реестр ответил ${response.status}`);
    });
    client.test("auth, profile, parameters и gateway в реестре", () => {
        const names = response.body.applications.application.map(app => app.name);
        ["AUTH", "PROFILE", "PARAMETERS", "GATEWAY"].forEach(name => {
            client.assert(names.includes(name), `В реестре нет ${name}: ${names}`);
        });
    });
%}

### Вход администратора
POST {{gateway}}/auth/login
Content-Type: application/json

{
  "login": "{{adminLogin}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("Администратор входит и получает пару токенов", () => {
        client.assert(response.status === 200, `Вход ответил ${response.status}`);
        client.assert(typeof response.body.access_token === "string", "Нет access_token");
        client.assert(typeof response.body.refresh_token === "string", "Нет refresh_token");
        client.assert(response.body.token_type === "Bearer", `Тип ${response.body.token_type}`);
    });
    client.global.set("adminToken", response.body.access_token);
%}

### Вход с неверным паролем отклоняется
POST {{gateway}}/auth/login
Content-Type: application/json

{
  "login": "{{adminLogin}}",
  "password": "неверный-{{$random.alphanumeric(6)}}"
}

> {%
    client.test("Неверный пароль даёт 401", () => {
        client.assert(response.status === 401, `Ожидался 401, пришёл ${response.status}`);
    });
%}

### Регистрация пользователя
< {%
    client.global.set("login", "user" + Date.now());
    client.global.set("password", "п4роль-" + Math.random().toString(36).slice(2));
%}
POST {{gateway}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "{{password}}",
  "name": "Иван"
}

> {%
    client.test("Учётка создана с ролью USER", () => {
        client.assert(response.status === 201, `Регистрация ответила ${response.status}`);
        client.assert(response.body.role === "USER", `Роль ${response.body.role}`);
    });
    client.test("Пароль не возвращается", () => {
        client.assert(!("password" in response.body), "В ответе есть пароль");
    });
    client.global.set("userId", response.body.id);
%}

### Повторная регистрация того же логина
POST {{gateway}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "другой",
  "name": "Двойник"
}

> {%
    client.test("Занятый логин даёт 409", () => {
        client.assert(response.status === 409, `Ожидался 409, пришёл ${response.status}`);
    });
%}

### Вход пользователя
POST {{gateway}}/auth/login
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "{{password}}"
}

> {%
    client.test("Пользователь входит", () => {
        client.assert(response.status === 200, `Вход ответил ${response.status}`);
    });
    client.global.set("userToken", response.body.access_token);
    client.global.set("userRefresh", response.body.refresh_token);
%}

### Без токена /me недоступен
GET {{gateway}}/me

> {%
    client.test("Аноним получает 401", () => {
        client.assert(response.status === 401, `Ожидался 401, пришёл ${response.status}`);
    });
%}

### Поддельные заголовки X-User-* без токена не помогают
GET {{gateway}}/profiles/{{userId}}
X-User-Id: {{userId}}
X-User-Role: ADMIN
X-User-Login: hacker

> {%
    client.test("Подделка заголовков даёт 401", () => {
        client.assert(response.status === 401, `Ожидался 401, пришёл ${response.status}`);
    });
%}

### /me собирает профиль и характеристики
GET {{gateway}}/me
Authorization: Bearer {{userToken}}

> {%
    client.test("/me отвечает", () => {
        client.assert(response.status === 200, `/me ответил ${response.status}`);
    });
    client.test("Профиль свой, роль из токена", () => {
        client.assert(response.body.profile.login === client.global.get("login"), "Чужой логин");
        client.assert(response.body.profile.name === "Иван", `Имя ${response.body.profile.name}`);
        client.assert(response.body.profile.role === "USER", `Роль ${response.body.profile.role}`);
    });
    client.test("Характеристик пока нет", () => {
        client.assert(Object.keys(response.body.parameters).length === 0, "Характеристики не пусты");
    });
%}

### Пользователь читает свой профиль
GET {{gateway}}/profiles/{{userId}}
Authorization: Bearer {{userToken}}

> {%
    client.test("Свой профиль доступен", () => {
        client.assert(response.status === 200, `Чтение ответило ${response.status}`);
        client.assert(response.body.login === client.global.get("login"), "Чужой логин в ответе");
