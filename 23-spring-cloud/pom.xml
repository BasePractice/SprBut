<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ru.sprbut</groupId>
        <artifactId>sprbut-course</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>23-spring-cloud</artifactId>
    <name>SprBut :: 23 :: Spring Cloud: система из сервисов</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>qulice</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.qulice</groupId>
                        <artifactId>qulice-maven-plugin</artifactId>
                        <configuration>
                            <!--
                                Модуль стоит на стартерах Spring Boot и Spring Cloud:
                                стартер и нужен ради согласованного набора зависимостей,
                                которыми код пользуется напрямую. Требование объявить
                                каждую из них отдельно противоречит теме раздела.
                            -->
                            <!--
                                Одиннадцать jar-ов resilience4j несут одинаковый
                                COPYRIGHT.txt, и поиск дубликатов считает это
                                конфликтом. Файл не наш и не влияет ни на что,
                                кроме отчёта.
                            -->
                            <excludes>
                                <exclude>dependencies:.*</exclude>
                                <exclude>duplicatefinder:.*</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
